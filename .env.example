# Copy to .env. Every value is optional; unset sources report not_configured.

# Access control: viewer | operator | oncall (see config/policy.toml)
FDE_MCP_ROLE=viewer
# FDE_MCP_POLICY=config/policy.toml

# GitHub: fine-grained PAT, read-only on selected repos
GITHUB_TOKEN=

# SQLite ops DB: must already exist (create from db/schema.sql)
FDE_DB_PATH=data/ops.db

# Telegram: bot token from @BotFather + the one chat alerts may go to
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Real sends only when explicitly false
TELEGRAM_DRY_RUN=true
